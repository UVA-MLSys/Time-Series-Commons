# Copy this file to .env and fill in the values.
# The actual .env file must never be committed to git.

# PostgreSQL connection string via Cloud SQL Auth Proxy (localhost tunnel)
DB_CONN_STR=postgresql://ts_user:YOUR_SECURE_PASSWORD@127.0.0.1:5432/timeseries_db

# Absolute path to the local git clone of the repo on the VM
# The updater writes data/models.json here and runs git push from this directory
REPO_LOCAL_PATH=/home/ryangoud/Time-Series-Commons

# Git commit author identity (shows in GitHub commit history)
GIT_AUTHOR_NAME=TimeSeries Updater
GIT_AUTHOR_EMAIL=ryangoud@gmail.com

# Shared secret for the POST /ingest-from-sheets webhook.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Apps Script must send: Authorization: Bearer <this value>
WEBHOOK_SECRET=

# Port for this Flask service
UPDATER_PORT=8081
