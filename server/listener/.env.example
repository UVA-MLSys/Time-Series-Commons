# Copy this file to .env and fill in the values.
# The actual .env file must never be committed to git.

# PostgreSQL connection string via Cloud SQL Auth Proxy (localhost tunnel)
DB_CONN_STR=postgresql://ts_user:YOUR_SECURE_PASSWORD@127.0.0.1:5432/timeseries_db

# POST target for site updates — set to your website updater endpoint
# The listener will POST a JSON payload here whenever a row changes:
#   {"table":"datasets","action":"INSERT","id":42,"name":"...","updated_at":"..."}
SITE_UPDATE_URL=https://your-website-updater-endpoint/update

# Port for the Flask health/debug API
LISTENER_PORT=8080
