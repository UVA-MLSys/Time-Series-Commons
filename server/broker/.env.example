# ---------------------------------------------------------------------------
# Time Series Commons — Catalog Broker (.env)
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values before starting the service.
# ---------------------------------------------------------------------------

# PostgreSQL connection string — use Cloud SQL Auth Proxy on the VM (same as
# the listener and updater), or a direct connection from DeepCollector's host.
DB_CONN_STR=postgresql://ts_user:YOUR_SECURE_PASSWORD@127.0.0.1:5432/timeseries_db

# Shared secret used to authenticate POST requests.
# Generate with:   python3 -c "import secrets; print(secrets.token_hex(32))"
# This value must be passed as:   Authorization: Bearer <BROKER_SECRET>
BROKER_SECRET=replace-with-a-strong-random-secret

# Absolute path to the domain config file.
# On the VM this is the repo clone; from DeepCollector it can be a separate copy.
DOMAIN_CONFIG_PATH=/home/ryangoudjil/Time-Series-Commons/data/domain-config.json

# Port for the broker HTTP server (default 8083).
# Make sure this port is open in your firewall / GCP VPC firewall rules.
BROKER_PORT=8083
